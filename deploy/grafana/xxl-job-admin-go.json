{
  "annotations": { "list": [] },
  "description": "XXL-JOB-Admin-Go 调度中心监控大盘（4 核心指标）",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],

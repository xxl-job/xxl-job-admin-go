{
  "name": "xxl-job-admin-frontend",
  "version": "0.1.0",
  "description": "XXL-JOB 调度中心前端",
  "type": "module",
  "license": "GPL-3.0",
  "keywords": [
    "xxl-job",
    "vue3",
    "vite",
    "typescript",
    "element-plus",
    "scheduler"
  ],
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "preinstall": "node -e \"const v=process.versions.node.split('.');if(+v[0]<22||(+v[0]===22&&+v[1]<13)){console.error('\\x1b[31m错误: 需要 Node.js >= 22.13.0，当前版本:',process.version,'\\x1b[0m');process.exit(1)}\"",
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^11.3.0",
    "axios": "^1.18.1",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.3",
    "nprogress": "^0.2.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.39",
    "vue-i18n": "9",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/nprogress": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^3",
    "eslint-plugin-import": "^2",
    "eslint-plugin-vue": "^9",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "sass-loader": "^17.0.0",
    "typescript": "~7.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
